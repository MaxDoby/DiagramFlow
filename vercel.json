{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx nx build web",
  "outputDirectory": "dist/apps/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://diagramflow-api-maxdoby.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://diagramflow-api-maxdoby.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
